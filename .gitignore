# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
# no trailing slash, so a symlinked .venv is matched too, and a glob so a
# RENAMED venv is matched as well: on 2026-08-13 the archive's dev venv was
# renamed .venv-py39 during the Python migration and `git add -A` staged
# 14233 files of it, because the pattern was an exact name.
.venv*

# macOS
.DS_Store

# source-literature PDFs (possibly copyrighted): keep the index + bib, not the PDFs
PDF_papers/

# reference-setup notes and photographs
docs/reference_setup/

# Local working material, personal and correspondence documents, and
# unpublished drafts. tests/test_repo_hygiene.py fails if any path matching
# these ever becomes tracked. Both spellings of each name are listed.
/CLAUDE.md

/private/

docs/brief_*
docs/*audit*
docs/*red_team*
docs/*redteam*
docs/**/*red_team*
docs/**/*redteam*
docs/ChatGPT*
ChatGPT*
docs/CV_*
docs/PAPERS_PORTFOLIO.md
docs/PAPER1_SKELETON.md
docs/paper1/
docs/*inquiry*
docs/linkedin*
*.docx

# reference PDFs dropped into docs are never published
docs/apparatus/*.pdf
docs/*.pdf
.venv/
docs/*.tex

# local tool scratch and nested checkouts
.claude/
docs/reference_setup/photos/

# the gate's verdict sentinel: a local artefact, never committed
.ci_gate_verdict
