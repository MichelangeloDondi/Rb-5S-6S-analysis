@inproceedings{gourieroux2000,
  author = {Gourieroux, C. and Renault, E. and Touzi, N.},
  title  = {Calibration by simulation for small sample bias correction},
  booktitle= {Simulation-based Inference in Econometrics: Methods and
             Applications (Cambridge University Press)},
  pages  = {328-358},
  year   = {2000},
  doi    = {10.1017/CBO9780511751981.018},
  note   = {PDF\_papers/Gourieroux\_2000\_calibration-simulation-small-sample-bias-correction.pdf.
             [CITE] Indirect inference as an exact small-sample bias
             correction. When the auxiliary estimator has as many
             parameters as the model, indirect inference with infinitely
             many simulations returns the parameter at which the
             finite-sample mean of the simulated estimates equals the
             observed estimate: the inverse of the finite-sample binding
             function. That estimator is exactly unbiased in the sense of
             a generalized mean, and unbiased to second order under an
             Edgeworth expansion, like the bootstrap. Unlike the
             bootstrap, the second-order property fails for a fixed number
             of simulations, although the first-order bias still vanishes.
             It is the mean analogue of Andrews' median-unbiased estimator
             for AR models. In AR(1) and AR(2) simulations it and the
             median-unbiased estimator are close, while least squares is
             strongly biased. The held PDF is the working-paper version
             (July 1994, revised July 1995), posted for a Federal Reserve
             Bank of Minneapolis conference of November 1995, not the book
             chapter of 2000; the chapter's page range and DOI are from
             Crossref, and its numbering may differ from the preprint's.
             Read on 2026-09-22: the abstract, introduction, Section 1
             (Proposition 1.1 and Examples 1 and 2), the statements of
             Section 2 (Proposition 2.1 and Corollary 2.1) and Section 3's
             tables; the appendix proofs are not read..}
}

